# Sem esta variável o app usa os adaptadores em memória (dados de exemplo, nada é salvo).
# Com ela, usa a API e o tempo real (SSE). Ex.: https://api.seudominio.com
NEXT_PUBLIC_API_URL=

# Nome do cookie de sessão que a API grava (httpOnly, Domain=.seudominio.com).
NEXT_PUBLIC_COOKIE_SESSAO=expresso_sessao
