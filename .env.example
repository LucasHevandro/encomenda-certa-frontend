# Sem esta variável o app usa os adaptadores em memória (dados de exemplo, nada é salvo).
# Recomendado: /api. O navegador chama /api/... no próprio endereço do app e o Next repassa para
# API_INTERNA; assim o cookie de sessão funciona em qualquer aparelho, inclusive no celular pela rede.
# Também aceita um endereço completo, ex.: https://api.seudominio.com (aí o cookie precisa de Domain).
NEXT_PUBLIC_API_URL=/api

# Para onde o Next repassa /api/... (visto pelo servidor do Next, não pelo navegador).
API_INTERNA=http://localhost:3333

# Nome do cookie de sessão que a API grava (httpOnly).
NEXT_PUBLIC_COOKIE_SESSAO=expresso_sessao
